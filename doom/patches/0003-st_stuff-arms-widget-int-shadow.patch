PZDOOM patch 0003 — arms widgets read int copies of weaponowned[]

Bind w_arms[] to an int shadow array (updated in ST_updateWidgets / seeded in
ST_initData) instead of (int *) &plyr->weaponowned[i+1], so the widget code
no longer depends on sizeof(boolean) == sizeof(int). Also passes the icon
counts introduced by patch 0002.
Applies on top of ozkl/doomgeneric @ 3b1d53020373b502035d7d48dede645a7c429feb.

diff --git a/doomgeneric/st_stuff.c b/doomgeneric/st_stuff.c
index e25accc..f116b96 100644
--- a/doomgeneric/st_stuff.c
+++ b/doomgeneric/st_stuff.c
@@ -380,10 +380,16 @@ static int	st_facecount = 0;
 static int	st_faceindex = 0;
 
 // holds key-type for each key box on bar
-static int	keyboxes[3]; 
+static int	keyboxes[3];
+
+// PZDOOM: int copies of plyr->weaponowned[1..6] for the w_arms[] widgets.
+// id's code bound the widgets straight to (int *) &plyr->weaponowned[i+1],
+// which is only correct while sizeof(boolean) == sizeof(int); keep the
+// widget contract (int *) independent of the boolean typedef instead.
+static int	st_weaponowned[6];
 
 // a random number per tick
-static int	st_randomnumber;  
+static int	st_randomnumber;
 
 cheatseq_t cheat_mus = CHEAT("idmus", 2);
 cheatseq_t cheat_god = CHEAT("iddqd", 0);
@@ -894,6 +900,10 @@ void ST_updateWidgets(void)
 	    keyboxes[i] = i+3;
     }
 
+    // PZDOOM: update arms ownership widgets (see st_weaponowned)
+    for (i=0;i<6;i++)
+	st_weaponowned[i] = plyr->weaponowned[i+1] ? 1 : 0;
+
     // refresh everything if this is him coming back to life
     ST_updateFaceWidget();
 
@@ -1218,6 +1228,10 @@ void ST_initData(void)
     for (i=0;i<3;i++)
 	keyboxes[i] = -1;
 
+    // PZDOOM: seed the arms widgets before the first ST_Ticker()
+    for (i=0;i<6;i++)
+	st_weaponowned[i] = plyr->weaponowned[i+1] ? 1 : 0;
+
     STlib_init();
 
 }
@@ -1264,7 +1278,7 @@ void ST_createWidgets(void)
 	STlib_initMultIcon(&w_arms[i],
 			   ST_ARMSX+(i%3)*ST_ARMSXSPACE,
 			   ST_ARMSY+(i/3)*ST_ARMSYSPACE,
-			   arms[i], (int *) &plyr->weaponowned[i+1],
+			   arms[i], 2, &st_weaponowned[i],
 			   &st_armson);
     }
 
@@ -1281,7 +1295,7 @@ void ST_createWidgets(void)
     STlib_initMultIcon(&w_faces,
 		       ST_FACESX,
 		       ST_FACESY,
-		       faces,
+		       faces, ST_NUMFACES,
 		       &st_faceindex,
 		       &st_statusbaron);
 
@@ -1297,21 +1311,21 @@ void ST_createWidgets(void)
     STlib_initMultIcon(&w_keyboxes[0],
 		       ST_KEY0X,
 		       ST_KEY0Y,
-		       keys,
+		       keys, NUMCARDS,
 		       &keyboxes[0],
 		       &st_statusbaron);
-    
+
     STlib_initMultIcon(&w_keyboxes[1],
 		       ST_KEY1X,
 		       ST_KEY1Y,
-		       keys,
+		       keys, NUMCARDS,
 		       &keyboxes[1],
 		       &st_statusbaron);
 
     STlib_initMultIcon(&w_keyboxes[2],
 		       ST_KEY2X,
 		       ST_KEY2Y,
-		       keys,
+		       keys, NUMCARDS,
 		       &keyboxes[2],
 		       &st_statusbaron);
 
